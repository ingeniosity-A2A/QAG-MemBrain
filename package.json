{
  "name": "ava007-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "AVA007 Sovereign Context Runtime",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "./start.sh",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:strict:authority": "AVA007_STRICT_AUTHORITY_VERIFICATION=true vitest run tests/authority/strict-mode.test.ts tests/authority/historical-verification.test.ts tests/authority/manifest.verification.test.ts tests/authority/rotation.test.ts tests/authority/signer.registry.test.ts",
    "test:strict:evaluation": "AVA007_STRICT_AUTHORITY_VERIFICATION=true vitest run tests/evaluation/evaluation.signature.strict.test.ts",
    "test:strict": "npm run test:strict:authority && npm run test:strict:evaluation",
    "verify": "node dist/bin/ava007.js",
    "evaluate": "npm run build && node dist/evaluation/runEvaluation.js",
    "benchmark:reconstruction": "npm run build && node dist/evaluation/benchmark/runReconstructionBenchmark.js",
    "evaluate:memory-judge": "npm run build && node dist/evaluation/memoryJudge/runMemoryJudge.js",
    "mobile:sync": "cd apps/mobile && npx cap sync android",
    "mobile:open": "cd apps/mobile && npx cap open android"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.10.0",
    "gsap": "^3.15.0",
    "neo4j-driver": "^6.0.1",
    "serialport": "^13.0.0",
    "sqlite-vec": "^0.1.9",
    "telnyx": "^6.74.2",
    "ulid": "^2.3.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^3.22.4"
  }
}