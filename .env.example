# AVA007 Sovereign Runtime

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sovereign_context_secret

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_key

# Cave Agent
CAVE_AGENT_URL=http://cave:5001

# Hermes
HERMES_URL=http://hermes:8081

# Port
PORT=3000

# Cloudflare Zero Trust
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# Telnyx (SMS + Voice)
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+14044391350
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_SIP_USER=
TELNYX_SIP_PASS=

# LoRa (optional)
LORA_SERIAL_PORT=/dev/ttyUSB0
LORA_BAUD_RATE=115200

# Backhaul failover
CELLULAR_PING_HOST=8.8.8.8
BACKHAUL_HEARTBEAT_INTERVAL_MS=30000

# Edge device ID
EDGE_DEVICE_DID=did:ava:s25-ultra

# Mellum2 (local Ollama)
MELLUM2_ENDPOINT=http://localhost:11434/api/generate
MELLUM2_MODEL=mellum2

# Mercury2 (Inception Labs)
MERCURY2_ENDPOINT=https://api.inceptionlabs.ai/v1/chat/completions
MERCURY2_MODEL=mercury-coder-small
MERCURY2_API_KEY=

# HuggingFace
HF_TOKEN=