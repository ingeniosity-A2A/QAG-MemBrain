# AVA007 Environment Variables
# Copy this file to .env and fill in your values

# OpenAI (Codex / GPT-4o)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# HuggingFace (model downloads)
HF_TOKEN=hf_xxxxxxxxxxxx

# Telnyx (WhatsApp/SMS)
TELNYX_API_KEY=KEYxxxxxxxxxxxx

# Cloudflare
CLOUDFLARE_API_TOKEN=cfat_xxxxxxxxxxxx

# Mercury 2 (Inception Labs)
MERCURY2_API_KEY=
MERCURY2_ENDPOINT=https://api.inceptionlabs.ai/v1/chat/completions
MERCURY2_MODEL=mercury-2

# Mellum2 (local Ollama)
MELLUM2_ENDPOINT=http://localhost:11434/api/generate
MELLUM2_MODEL=mellum2

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# AVA007 Worker
AVA007_WORKER_URL=https://your-worker.your-subdomain.workers.dev
AVA007_DEVICE_TOKEN=
AVA007_WEBHOOK_SECRET=

# Business
BUSINESS_PHONE=+1xxxxxxxxxx
