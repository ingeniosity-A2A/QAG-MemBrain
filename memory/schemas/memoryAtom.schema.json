{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qag-membrain/memoryAtom.schema.json",
  "title": "MemoryAtom",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "timestamp",
    "actor",
    "type",
    "payload",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {},
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}