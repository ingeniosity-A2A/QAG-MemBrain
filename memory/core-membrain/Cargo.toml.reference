# Reference copy of original Core-Membrain Cargo.toml
# Full build tree lives in the archived Core-Membrain repo until deletion.

[package]
name = "ingenosity-core"
version = "3.0.0"
edition = "2021"
authors = ["Ingenosity Core Team"]
description = "Ingenosity Core — JSON-Native Adaptive Intelligence Architecture"
license = "MIT"

[[bin]]
name = "ingenosity"
path = "src/main.rs"

[lib]
name = "ingenosity_core"
path = "src/lib.rs"

[dependencies]
tokio = { version = "1.40", features = ["full"] }
async-trait = "0.1"
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0", features = ["preserve_order"] }
serde_yaml = "0.9"
toml = "0.8"
reqwest = { version = "0.12", features = ["json", "rustls-tls"] }
axum = { version = "0.7", features = ["ws"] }
tower = "0.5"
tower-http = { version = "0.6", features = ["cors", "trace"] }
hyper = "1.0"
scraper = "0.21"
select = "0.6"
regex = "1.10"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "json"] }
tracing-appender = "0.2"
uuid = { version = "1.10", features = ["v4", "serde"] }
chrono = { version = "0.4", features = ["serde"] }
anyhow = "1.0"
thiserror = "2.0"
dotenvy = "0.15"
bytes = "1.7"
futures = "0.3"
dashmap = "6.0"
parking_lot = "0.12"
