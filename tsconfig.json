{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "authority/**/*.ts",
    "memory/**/*.ts",
    "graph/**/*.ts",
    "temporal/**/*.ts",
    "lineage/**/*.ts",
    "policy/**/*.ts",
    "governance/**/*.ts",
    "audit/**/*.ts",
    "consensus/**/*.ts",
    "brain/**/*.ts",
    "evaluation/**/*.ts",
    "accelerators/**/*.ts",
    "interfaces/**/*.ts",
    "tests/**/*.ts"
  ]
}