{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "shared/**/*.ts",
    "contract/**/*.ts",
    "memory/atomic_memory.ts",
    "tashi/**/*.ts",
    "temporal/**/*.ts",
    "retrieval/**/*.ts",
    "subconscious/**/*.ts",
    "brain/**/*.ts",
    "fusion/**/*.ts",
    "quantum/**/*.ts",
    "proximity/**/*.ts",
    "pipeline_impl.ts"
  ]
}
