{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@ava007/*": ["src/*"],
      "@runtime/*": ["src/runtime/*"],
      "@core/*": ["src/core/*"],
      "@memory/*": ["src/memory/*"],
      "@graph/*": ["src/graph/*"],
      "@execution/*": ["src/execution/*"],
      "@telecom/*": ["src/telecom/*"],
      "@edge/*": ["src/edge/*"],
      "@subconscious/*": ["src/subconscious/*"],
      "@a2a/*": ["src/a2a/*"],
      "@training/*": ["src/training/*"],
      "@contract/*": ["src/contract/*"],
      "@app/*": ["src/app/*"],
      "@packages/*": ["packages/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "bin/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "evaluation", "tests", "test"]
}